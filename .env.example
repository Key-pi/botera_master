# BoteraMaster local Docker environment. Copy once:
#   cp .env.example .env

DJANGO_SECRET_KEY=botera-master-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# PostgreSQL and Redis stay inside Docker by default.
POSTGRES_DB=botera_master
POSTGRES_USER=botera_master
POSTGRES_PASSWORD=botera_master

# Web is exposed only on this computer. BoteraShop keeps its usual port 8000.
WEB_BIND_ON_HOST=127.0.0.1
WEB_PORT_ON_HOST=8001
# Used only with infrastructure/docker/compose.ports.yml.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Generate a Fernet key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Comma-separated key ring: key-id:fernet-key,key-id-2:fernet-key-2
BOT_TOKEN_ENCRYPTION_KEYS=local:
BOT_TOKEN_CURRENT_KEY_ID=local
# Generate a separate value with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
TOKEN_FINGERPRINT_KEY=

# Idempotent local data created by the one-shot init container. Real Telegram
# bot tokens are entered only through Admin and are never stored in this file.
DEMO_SEED=true
DEMO_PARTNER_NAME=Preview Studio
DEMO_ADMIN_USERNAME=platform_admin
DEMO_ADMIN_PASSWORD=botera12345
DEMO_OWNER_USERNAME=preview_owner
DEMO_OWNER_PASSWORD=botera12345
