DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production ingress. Replace placeholder values before using the production
# Compose overlay; production settings reject short/default secrets.
BOTERA_DOMAIN=botera.example.com
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

POSTGRES_DB=botera_master
POSTGRES_USER=botera_master
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional host-only ports for local access. Compose binds them to 127.0.0.1.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Generate a Fernet key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Comma-separated key ring: key-id:fernet-key,key-id-2:fernet-key-2
BOT_TOKEN_ENCRYPTION_KEYS=
BOT_TOKEN_CURRENT_KEY_ID=
# Generate a separate value with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
TOKEN_FINGERPRINT_KEY=
