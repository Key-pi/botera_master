# Copy to .env.production and fill every value before a public deployment.
# Keep the file readable only by the deployment account and never commit it.

BOTERA_DOMAIN=master.example.com
DJANGO_SECRET_KEY=

POSTGRES_DB=botera_master
POSTGRES_USER=botera_master
POSTGRES_PASSWORD=
# Generate a URL-safe value, because it is embedded in Redis connection URLs:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
REDIS_PASSWORD=

# Comma-separated key ring: key-id:fernet-key,key-id-2:fernet-key-2
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BOT_TOKEN_ENCRYPTION_KEYS=
BOT_TOKEN_CURRENT_KEY_ID=
# Generate independently from the Fernet key:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
TOKEN_FINGERPRINT_KEY=

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
